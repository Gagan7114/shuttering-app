# Copy to backend/.env (setup.sh does this for you) and fill in.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# PostgreSQL connection
DB_NAME=shuttering
DB_USER=shuttering
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

TIME_ZONE=Asia/Kolkata
# Comma separated; * = any address (needed for phones on the shop Wi-Fi)
ALLOWED_HOSTS=*
